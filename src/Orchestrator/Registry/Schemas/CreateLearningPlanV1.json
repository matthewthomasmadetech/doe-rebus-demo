{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateLearningPlanV1",
  "type": "object",
  "required": ["CorrelationId", "LearnerId", "LearningGoal"],
  "properties": {
    "CorrelationId": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "LearnerId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "LearningGoal": { "type": "string", "minLength": 1, "maxLength": 160 },
    "PreferredFormat": { "enum": ["online", "workbook", null] }
  }
}
