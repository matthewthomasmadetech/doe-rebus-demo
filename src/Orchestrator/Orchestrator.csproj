<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Rebus.AzureQueues" />
    <PackageReference Include="Rebus.ServiceProvider" />
    <PackageReference Include="Rebus.SqlServer" />
    <!-- Override the vulnerable version brought in by Microsoft.Data.SqlClient. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <ProjectReference Include="../Messaging/Messaging.csproj" />
    <Compile Include="../Shared/DemoConsoleLogging.cs" Link="DemoConsoleLogging.cs" />
    <!-- The registry seeds contract schemas from these files at startup. -->
    <Content Update="Registry/Schemas/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
