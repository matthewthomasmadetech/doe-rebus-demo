{
  "ConnectionStrings": {
    "RebusSqlServer": "Server=127.0.0.1,1433;Database=RebusDemo;User ID=sa;Password=RebusDemo_local2022!;Encrypt=True;TrustServerCertificate=True"
  },
  "Registry": {
    "Routes": [
      { "WorkflowType": "register-learner", "MessageType": "RebusDemo.Contracts.CreateLearnerV1, Contracts", "Queues": ["create-learner-v1"], "SchemaFile": "Registry/Schemas/CreateLearnerV1.json" },
      { "WorkflowType": "register-learner", "MessageType": "RebusDemo.Contracts.CreateLearnerV2, Contracts", "Queues": ["create-learner-v2"], "SchemaFile": "Registry/Schemas/CreateLearnerV2.json" },
      { "WorkflowType": "register-learner", "MessageType": "RebusDemo.Contracts.CreateLearningPlanV1, Contracts", "Queues": ["create-learning-plan-v1"], "SchemaFile": "Registry/Schemas/CreateLearningPlanV1.json" },
      { "WorkflowType": "register-learner", "MessageType": "RebusDemo.Contracts.ScheduleAssessmentV1, Contracts", "Queues": ["schedule-assessment-v1"], "SchemaFile": "Registry/Schemas/ScheduleAssessmentV1.json" },
      { "WorkflowType": "send-learner-reminder", "MessageType": "RebusDemo.Contracts.SendLearnerReminderV1, Contracts", "Queues": ["send-learner-reminder-v1"], "SchemaFile": "Registry/Schemas/SendLearnerReminderV1.json" }
    ]
  },
  "Workflows": [
    {
      "Name": "register-learner",
      "StartMessageType": "RegisterLearnerV1",
      "StartSchemaFile": "Registry/Schemas/RegisterLearnerV1.json",
      "Transitions": [
        {
          "FromState": "New", "OnMessageType": "RegisterLearnerV1", "Priority": 1,
          "WhenPresent": "PreferredName", "ToState": "AwaitingLearner",
          "SendMessageType": "RebusDemo.Contracts.CreateLearnerV2, Contracts",
          "SendMapping": { "CorrelationId": "CorrelationId", "FirstName": "FirstName", "LastName": "LastName", "Email": "Email", "PreferredName": "PreferredName" }
        },
        {
          "FromState": "New", "OnMessageType": "RegisterLearnerV1", "Priority": 2,
          "ToState": "AwaitingLearner",
          "SendMessageType": "RebusDemo.Contracts.CreateLearnerV1, Contracts",
          "SendMapping": { "CorrelationId": "CorrelationId", "FirstName": "FirstName", "LastName": "LastName", "Email": "Email" }
        },
        {
          "FromState": "AwaitingLearner", "OnMessageType": "RebusDemo.Contracts.LearnerCreated, Contracts",
          "ToState": "AwaitingLearningPlan",
          "SendMessageType": "RebusDemo.Contracts.CreateLearningPlanV1, Contracts",
          "SendMapping": { "CorrelationId": "CorrelationId", "LearnerId": "LearnerId", "LearningGoal": "LearningGoal", "PreferredFormat": "PreferredFormat" }
        },
        {
          "FromState": "AwaitingLearner", "OnMessageType": "RebusDemo.Contracts.LearnerCreationFailed, Contracts",
          "ToState": "Failed"
        },
        {
          "FromState": "AwaitingLearningPlan", "OnMessageType": "RebusDemo.Contracts.LearningPlanCreated, Contracts",
          "ToState": "AwaitingAssessment",
          "SendMessageType": "RebusDemo.Contracts.ScheduleAssessmentV1, Contracts",
          "SendMapping": { "CorrelationId": "CorrelationId", "LearnerId": "LearnerId", "LearningPlanId": "LearningPlanId", "RequestedAtUtc": "StartedAtUtc" }
        },
        {
          "FromState": "AwaitingLearningPlan", "OnMessageType": "RebusDemo.Contracts.LearningPlanCreationFailed, Contracts",
          "ToState": "Failed"
        },
        {
          "FromState": "AwaitingAssessment", "OnMessageType": "RebusDemo.Contracts.AssessmentScheduled, Contracts",
          "ToState": "Completed"
        },
        {
          "FromState": "AwaitingAssessment", "OnMessageType": "RebusDemo.Contracts.AssessmentSchedulingFailed, Contracts",
          "ToState": "Failed"
        }
      ]
    }
  ]
}
